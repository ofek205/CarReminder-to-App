<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple — required by App Store Review Guideline 4.8
	     because the app offers Google as a third-party login. Without
	     this entitlement, the Capacitor `@capacitor-community/apple-sign-in`
	     plugin's authorize() call fails with "ASAuthorizationErrorUnknown"
	     on the device even though everything else (Apple Dev cap, Services
	     ID, Supabase provider) is configured correctly.
	     `Default` is the standard scope; we don't restrict to a sub-domain. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Push Notifications — required by @capacitor/push-notifications so
	     the OS can issue an APNs token and route remote pushes to the app.
	     Value rules:
	       - 'development' — APNs sandbox (api.sandbox.push.apple.com).
	         Used for Xcode debug builds installed via cable/simulator.
	       - 'production'  — APNs production (api.push.apple.com). Apple
	         AUTO-PROMOTES 'development' to 'production' when the binary is
	         signed with an Apple Distribution cert (TestFlight + App Store),
	         so a single 'development' value here works for every build
	         path and we don't have to maintain per-config entitlements.
	     Pair with APNS_USE_SANDBOX in the dispatch-push Edge Function:
	       development env ↔ APNS_USE_SANDBOX=true
	       production env  ↔ APNS_USE_SANDBOX=false (flip on App Store release). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links. Without this entitlement iOS never even FETCHES
	     the apple-app-site-association file, so every https://car-reminder.app
	     link we send by email or SMS opens in Safari instead of the app.
	     The server half has been live since 2026-09-19 and serves 200 with
	     Content-Type application/json and no redirect, which is exactly what
	     Apple requires; this is the client half that was never added.
	     Android already claims the same three paths (/JoinInvite,
	     /VehicleTransfer, /Notifications) via autoVerify intent-filters.
	     Apex only: www.car-reminder.app does not resolve, so claiming it
	     would just be a domain iOS fails to validate on every install.
	     REQUIRES the Associated Domains capability on the App ID in the
	     Apple Developer portal. Without it the profile lacks the
	     entitlement and codesign FAILS the build. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:car-reminder.app</string>
	</array>
</dict>
</plist>
