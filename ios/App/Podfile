require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor',                    :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova',             :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorApp',                 :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorBrowser',             :path => '../../node_modules/@capacitor/browser'
  pod 'CapacitorCamera',              :path => '../../node_modules/@capacitor/camera'
  pod 'CapacitorFilesystem',          :path => '../../node_modules/@capacitor/filesystem'
  pod 'CapacitorGeolocation',         :path => '../../node_modules/@capacitor/geolocation'
  pod 'CapacitorHaptics',             :path => '../../node_modules/@capacitor/haptics'
  pod 'CapacitorKeyboard',            :path => '../../node_modules/@capacitor/keyboard'
  pod 'CapacitorLocalNotifications',  :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CapacitorPreferences',         :path => '../../node_modules/@capacitor/preferences'
  # Push Notifications — same CocoaPods footgun as Apple Sign-In below.
  # @capacitor/push-notifications is in package.json and Android auto-links
  # it via gradle, but the iOS build is CocoaPods-driven and this pod entry
  # was never added — so PushNotifications.register() finds no native bridge,
  # the `registration` event never fires, and iOS gets 0 APNs tokens while
  # Android works. Diagnosed 2026-06-26: device_tokens had 242 android / 0 ios.
  pod 'CapacitorPushNotifications',   :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapacitorShare',               :path => '../../node_modules/@capacitor/share'
  pod 'CapacitorSplashScreen',        :path => '../../node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar',           :path => '../../node_modules/@capacitor/status-bar'
  # Sign in with Apple — required by Apple Guideline 4.8. Without this
  # pod entry, `npx cap sync ios` updates Package.swift (SPM) but the
  # actual iOS build uses CocoaPods, leaving the native SignInWithApple
  # bridge unregistered. The JS-side `SignInWithApple.authorize()` call
  # then hangs silently — the call routes through Capacitor's plugin
  # registry, finds no native handler, and the promise never resolves.
  pod 'CapacitorCommunityAppleSignIn', :path => '../../node_modules/@capacitor-community/apple-sign-in'
  # In-app review (SKStoreReviewController / Play In-App Review).
  # cap sync does not add pods. Without this line the iOS bridge is missing.
  pod 'CapacitorCommunityInAppReview', :path => '../../node_modules/@capacitor-community/in-app-review'
  # StoreKit 2 (App Store subscriptions). The THIRD time this footgun would
  # have bitten: @capgo/native-purchases has been in package.json since Play
  # Billing, Android links it through gradle, and it was never added here.
  # Without this line the iOS app has no native purchase bridge at all, and
  # the JS falls back to the plugin's web stub, which cannot sell anything.
  # Inert until the JS returns the Apple backend on iOS (docs/plan-apple-iap.md
  # §4); before that its only effect is a Transaction.updates listener at
  # launch with nothing to find. Never compiled locally (no Mac): the first
  # iOS CI build is the compile check, and it fails before the upload step.
  pod 'CapgoNativePurchases',         :path => '../../node_modules/@capgo/native-purchases'
end

target 'App' do
  capacitor_pods
end

post_install do |installer|
  assertDeploymentTarget(installer)

  # CapgoNativePurchases compiles its StoreKit billing-plan code (monthly
  # commitment plans, commitmentInfo) only under -D STOREKIT_26_5, and its
  # podspec turns that flag on if ANY of two SDKs has those APIs: the one in
  # DEVELOPER_DIR, and /Applications/Xcode.app, whatever that happens to be.
  # On the macos-26 runner the second one is a newer Xcode than the 26.4 the
  # release workflow pins, so the flag came on and the pod was then compiled
  # against the 26.4 SDK, which does not have those types (the Archive log
  # shows "-D STOREKIT_26_5" on this pod beside "iPhoneOS26.4.sdk"). The
  # first iOS build with this pod failed at Archive, exit 65.
  #
  # We sell none of those plan types, and every guarded block has a plain
  # fallback (the plugin's own message: "billingPlanType requires building
  # with Xcode 26.5 SDK or later"), so the flag is removed always rather than
  # re-detected. That keeps the build independent of which Xcode the runner
  # image links as the default. The podspec writes it into the generated
  # xcconfig, which a target-level build setting cannot take back ($(inherited)
  # would carry it through), so the xcconfig itself is rewritten.
  installer.pods_project.targets.each do |target|
    next unless target.name == 'CapgoNativePurchases'
    target.build_configurations.each do |config|
      path = config.base_configuration_reference.real_path
      xcconfig = File.read(path)
      next unless xcconfig.include?('STOREKIT_26_5')
      File.write(path, xcconfig.gsub(/\s*-D\s*STOREKIT_26_5/, ''))
      puts "CapgoNativePurchases (#{config.name}): removed -D STOREKIT_26_5"
    end
  end
end
