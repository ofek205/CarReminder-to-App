{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/commit-gate.cjs"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/design-nudge.cjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/design-nudge.cjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git push)",
      "PowerShell(git push:*)",
      "PowerShell(git push)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "PowerShell(git remote add:*)",
      "PowerShell(git remote set-url:*)",
      "Bash(gh:*)",
      "PowerShell(gh:*)",
      "Bash(npx cap:*)",
      "PowerShell(npx cap:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "PowerShell(vercel:*)",
      "PowerShell(npx vercel:*)",
      "Bash(npm publish:*)",
      "PowerShell(npm publish:*)",
      "Bash(gradlew:*)",
      "Bash(./gradlew:*)",
      "PowerShell(gradlew:*)",
      "PowerShell(.\\gradlew:*)",
      "Bash(xcodebuild:*)",
      "PowerShell(xcodebuild:*)"
    ]
  }
}
