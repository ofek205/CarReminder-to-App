#!/bin/sh
# Project pre-push gatekeeper - heavier checks before code leaves the machine.
# Skip with: git push --no-verify  (don't, unless you know exactly why)
#
# Portable shebang: uses /bin/sh, NOT `/usr/bin/env bash`. GitHub Desktop on
# Windows runs git with a stripped PATH where `env` can't find `bash`
# (/usr/bin/env: 'bash': No such file or directory) — which aborted the push.
# git always resolves /bin/sh via its bundled shell, so the hook starts.
# When node/npm aren't on PATH (GitHub Desktop's git env), the tool-dependent
# checks are SKIPPED with a warning instead of blocking — those same checks run
# in CI on every PR to main, and in any real dev terminal that has npm.

set -e
RED='\033[0;31m'; YEL='\033[1;33m'; GRN='\033[0;32m'; NC='\033[0m'
fail() { printf "${RED}[BLOCKED] %s${NC}\n" "$1" >&2; exit 1; }
warn() { printf "${YEL}[warn] %s${NC}\n" "$1" >&2; }
ok()   { printf "${GRN}[ok] %s${NC}\n" "$1"; }

# 1. Warn on direct push to main / master
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      warn "Pushing directly to $remote_ref. Press Ctrl+C in 5s to cancel..."
      sleep 5 || true
      ;;
  esac
done

# Find bash before anything else needs it.
#
# The skip-if-no-npm guard below was written for GitHub Desktop's stripped PATH,
# but it checked the wrong tool. npm IS on that PATH, so the guard passes and
# `npm run lint` runs -- and npm is configured here with
# script-shell=C:\Program Files\Git\bin\bash.exe, so it immediately dies with
#
#   /usr/bin/env: 'bash': No such file or directory
#
# which the hook then reported as "[BLOCKED] ESLint failed". ESLint never ran.
# That misdiagnosis blocked every push from GitHub Desktop for six weeks while
# the code was clean the whole time. Locate bash ourselves so the gates actually
# execute, and never let a PATH problem masquerade as a code problem.
if ! command -v bash >/dev/null 2>&1; then
  GIT_BIN_DIR=""
  if command -v git >/dev/null 2>&1; then
    GIT_BIN_DIR="$(dirname "$(command -v git)")"
  fi
  for d in "$GIT_BIN_DIR" "/c/Program Files/Git/bin" "/c/Program Files (x86)/Git/bin"; do
    [ -n "$d" ] || continue
    if [ -x "$d/bash.exe" ] || [ -x "$d/bash" ]; then
      PATH="$d:$PATH"; export PATH
      warn "bash was not on PATH; added $d so npm scripts can run."
      break
    fi
  done
fi

HAVE_NPM=0;  if command -v npm  >/dev/null 2>&1; then HAVE_NPM=1;  fi
HAVE_NODE=0; if command -v node >/dev/null 2>&1; then HAVE_NODE=1; fi
HAVE_BASH=0; if command -v bash >/dev/null 2>&1; then HAVE_BASH=1; fi

# npm without a usable shell cannot run a single script. Skipping is correct
# here -- CI enforces lint and build on every PR to main -- and it is far better
# than blocking a clean push with a wrong reason.
if [ "$HAVE_NPM" = 1 ] && [ "$HAVE_BASH" = 0 ]; then
  warn "npm found but bash is not -- npm scripts cannot run. Skipping lint/build; CI enforces both on PR to main."
  HAVE_NPM=0
fi

if [ "$HAVE_NPM" = 1 ]; then
  # 2. Full ESLint
  if [ -x node_modules/.bin/eslint ]; then
    npm run -s lint || fail "Lint step failed. If the output above shows a missing shell or command, that is an environment problem, not your code -- read it before running: npm run lint:fix"
    ok "eslint passed"
  fi
  # 3. Unit tests. Run BEFORE the build: the suite takes well under a second
  # and pins invariants the build cannot see (what may reach the offline cache,
  # the seam's envelope-vs-throw contract, every dal.run name resolving), so
  # failing here saves waiting ~30s for a build that was never the problem.
  if [ -x node_modules/.bin/vitest ]; then
    npm run -s test || fail "Unit tests failed. These pin offline-cache privacy and the DAL contract - read the failure before pushing."
    ok "unit tests passed"
  fi
  # 4. Production build must succeed
  if [ -x node_modules/.bin/vite ]; then
    npm run -s build || fail "Production build failed."
    ok "build passed"
  fi
else
  warn "npm not found (e.g. GitHub Desktop git env) - skipping local lint/build. CI enforces them on PR to main."
fi

# 4. Query-timeout gate - every Supabase call inside a useQuery must be wrapped
# with withTimeout(...) or Promise.race(...). Only needs node, so run it whenever
# node is present even if npm is not. See scripts/check-query-timeouts.cjs.
if [ "$HAVE_NODE" = 1 ] && [ -f scripts/check-query-timeouts.cjs ]; then
  node scripts/check-query-timeouts.cjs || fail "check-query-timeouts gate failed."
  ok "query-timeout gate passed"
elif [ "$HAVE_NODE" != 1 ]; then
  warn "node not found - skipping query-timeout gate. CI enforces it on PR to main."
fi

# 5. View-as identity gate - admin RPCs must go through adminSupabase, never the
# impersonation-proxied `supabase`. On the proxied client they arrive as the
# viewed user and fail is_admin(), usually silently. Fixed three times by hand in
# one day before this gate existed. See scripts/check-view-as-identity.cjs.
if [ "$HAVE_NODE" = 1 ] && [ -f scripts/check-view-as-identity.cjs ]; then
  node scripts/check-view-as-identity.cjs || fail "check-view-as-identity gate failed."
  ok "view-as identity gate passed"
elif [ "$HAVE_NODE" != 1 ]; then
  warn "node not found - skipping view-as identity gate. CI enforces it on PR to main."
fi

printf "${GRN}[ok] pre-push checks done${NC}\n"
exit 0
